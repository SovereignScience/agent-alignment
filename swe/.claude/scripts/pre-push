#!/usr/bin/python3 -I
"""pre-push: show what is about to leave this machine, and stop oversized pushes.

Agents cannot push, so this only ever asks the user. It asks for y when a push has
more than 3 commits, more than 80 added doc lines, more than 400 added lines in
total, a new doc file, an AI tell in docs or commit messages, AI attribution
anywhere, a commit whose author or committer is not this clone's user, or a
branch named for an agent. If git cannot work out what is being pushed, the push
is refused.
In a repository with a .privacy-allow file, privacy_check.py checks each pushed
commit first, and any finding refuses the push without asking.
An executable pre-push.local beside this hook runs after it.
"""
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
# git and pre-push.local resolve from root-owned directories, never from a PATH
# that a project venv put first.
os.environ["PATH"] = "/usr/local/bin:/usr/bin:/bin"
from privacy_check import AllowError, GitError, check_push, git, report
try:
    from tells_check import find_tells
except ImportError:
    def find_tells(text):
        return ["tell checker missing"] if text else []

MAX_COMMITS = 3
MAX_DOC_LINES = 80
MAX_LINES = 400
DOCS = (".md", ".txt", ".rst", ".adoc", ".html")
ZERO = "0" * 40
AGENT_BRANCH = re.compile(r"^refs/heads/(claude|codex|copilot|cursor|devin|gemini)/", re.I)


def pushed(updates, remote):
    """(local tip, the ref's commit on the remote or None, the commits it adds) for each ref being pushed;
    a deleted ref adds none. Only what this remote already has is left out: a commit another remote has
    may still be new here."""
    known = ["--not", "--remotes=" + remote] if remote in git("remote").split() else []
    ranges = []
    for line in updates.splitlines():
        parts = line.split()
        if len(parts) != 4:
            raise GitError("unexpected push input: %r" % line[:120])
        local_sha, remote_sha = parts[1], parts[3]
        if local_sha == ZERO:
            continue
        if remote_sha == ZERO:
            ranges.append((local_sha, None, git("rev-list", local_sha, *known).split()))
            continue
        try:
            git("cat-file", "-e", remote_sha + "^{commit}")
        except GitError:
            raise GitError("remote commit %s is not in this clone; fetch first" % remote_sha[:12])
        ranges.append((local_sha, remote_sha, git("rev-list", "%s..%s" % (remote_sha, local_sha)).split()))
    return ranges


def public_commit(updates, remote):
    """A commit the remote already has, whose files show which words are public there: the old tip of a
    ref being pushed, else the remote's default branch, else None."""
    for line in updates.splitlines():
        if line.split()[3] != ZERO:
            return line.split()[3]
    if remote not in git("remote").split():
        return None
    try:
        return git("rev-parse", "--verify", "-q", "refs/remotes/%s/HEAD^{commit}" % remote).strip()
    except GitError:
        return None


def measure(shas):
    doc_lines = all_lines = 0
    new_docs, prose, added = [], [], []
    for sha in shas:
        for row in git("show", "--numstat", "--format=", sha).splitlines():
            cols = row.split("\t")
            if len(cols) == 3 and cols[0].isdigit():
                all_lines += int(cols[0])
                if cols[2].lower().endswith(DOCS):
                    doc_lines += int(cols[0])
        new_docs += [p for p in git("show", "--diff-filter=A", "--name-only", "--format=", sha).split()
                     if p.lower().endswith(DOCS)]
        prose.append(git("log", "-1", "--format=%B", sha))
        for line in git("show", "--format=", "-U0", sha).splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                added.append(line[1:])
        diff = git("show", "--format=", "-U0", sha, "--", *["*" + d for d in DOCS])
        prose += [l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]
    tells = find_tells("\n".join(prose))
    if "AI attribution" in find_tells("\n".join(added)) and "AI attribution" not in tells:
        tells.append("AI attribution in code")
    return doc_lines, all_lines, sorted(set(new_docs)), tells


def not_mine(shas):
    """Authors and committers of the pushed commits other than this clone's user."""
    if not shas:
        return []
    me = "%s <%s>" % (git("config", "user.name").strip(), git("config", "user.email").strip())
    people = set()
    for sha in shas:
        for person in git("log", "-1", "--format=%an <%ae>%n%cn <%ce>", sha).splitlines():
            if person.lower() != me.lower():
                people.add(person)
    return sorted(people)


def agent_branches(updates):
    lines = [line.split() for line in updates.splitlines() if len(line.split()) == 4]
    return sorted(remote for _, sha, remote, _ in lines if sha != ZERO and AGENT_BRANCH.match(remote))


def confirm(summary):
    print(summary, file=sys.stderr)
    try:
        with open("/dev/tty") as tty_in, open("/dev/tty", "w") as tty_out:
            tty_out.write("Push anyway? Type y to continue: ")
            tty_out.flush()
            return tty_in.readline().strip().lower() == "y"
    except OSError:
        print("No terminal to confirm on; push refused.", file=sys.stderr)
        return False


def main():
    updates = sys.stdin.read()
    try:
        remote = sys.argv[1] if len(sys.argv) > 1 else ""
        ranges = pushed(updates, remote)
        shas = list(dict.fromkeys(sha for _, _, commits in ranges for sha in commits))
        private = check_push(ranges, public_commit(updates, remote))
        doc_lines, all_lines, new_docs, tells = measure(shas)
        others, branches = not_mine(shas), agent_branches(updates)
    except (GitError, AllowError) as err:
        print("Push check could not read this push (%s); push refused." % err, file=sys.stderr)
        return 1
    if report(private, "push"):
        return 1
    summary = "Push check: %d commits, %d lines added (%d in docs), %d new doc files%s%s." % (
        len(shas), all_lines, doc_lines, len(new_docs),
        " (%s)" % ", ".join(new_docs[:5]) if new_docs else "",
        "; AI tells: " + ", ".join(tells) if tells else "")
    if others:
        summary += "\nNot authored and committed by you: " + ", ".join(others) + "."
    if branches:
        summary += "\nBranch named for an agent: " + ", ".join(branches) + "."
    over = (len(shas) > MAX_COMMITS or doc_lines > MAX_DOC_LINES or all_lines > MAX_LINES
            or new_docs or tells or others or branches)
    if over:
        limits = "Limits: %d commits, %d lines, %d doc lines, no new docs, no tells, your commits only." % (
            MAX_COMMITS, MAX_LINES, MAX_DOC_LINES)
        if not confirm(summary + "\n" + limits):
            return 1
    else:
        print(summary, file=sys.stderr)
    local = os.path.join(os.path.dirname(os.path.realpath(__file__)), "pre-push.local")
    if os.access(local, os.X_OK):
        return subprocess.run([local, *sys.argv[1:]], input=updates, text=True).returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())
