      "Read(~/.ssh)",
      "Read(~/.kube)",
      "Read(~/.config/gh)",
      "Read(~/.config/age)",
      "Read(~/.gnupg)",
      "Read(~/.password-store)",
      "Read(~/.docker/config.json/**)",
      "Read(~/.codex/auth.json/**)",
      "Read(~/.claude/.credentials.json/**)",
      "Read(~/.npmrc)",
      "Read(~/.npmrc/**)",
      "Read(~/.pypirc)",
      "Read(~/.pypirc/**)",
      "Read(~/.git-credentials/**)",
      "Read(~/.aws)",
      "Read(~/.netrc/**)",
      "Read(~/.config/gcloud)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/b2)",
      "Read(~/.config/b2/**)",
      "Read(~/.config/doctl)",
      "Read(~/.config/doctl/**)",
      "Read(//mnt/c/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "deb.debian.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ],
      "strictAllowlist": true,
      "allowManagedDomainsOnly": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache-agent"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude/hooks",
        "~/.claude/agents",
        "~/.codex",
        "/etc/claude-code",
        "~/projects/CLAUDE.md"
      ],
      "denyRead": [
        "/mnt/c",
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials",
        "~/.config/git/credentials",
        "~/.ssh",
        "~/.kube",
        "~/.config/gh",
        "~/.config/age",
        "~/.gnupg",
        "~/.password-store",
        "~/.docker/config.json",
        "~/.codex/auth.json",
        "~/.codex/config.toml",
        "~/.codex/sessions",
        "~/.claude/.credentials.json",
        "~/.claude/projects",
        "~/.claude.json",
        "~/.npmrc",
        "~/.pypirc",
        "~/.git-credentials",
        "~/.aws",
        "~/.netrc",
        "~/.config/gcloud",
        "~/.config/b2",
        "~/.config/doctl",
        "~/.config/helm",
        "~/.config/pinniped",
        "~/.gsutil",
        "~/.vault-token",
        "~/.config/agent-alignment",
        "~/.bash_history",
        "~/.python_history",
        "~/.node_repl_history",
        "~/.mozilla",
        "~/.config/chromium",
        "~/.config/google-chrome",
        "~/.copilot",
        "~/.gemini"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/age",
          "mode": "deny"
        },
        {
          "path": "~/.password-store",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.codex/auth.json",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
