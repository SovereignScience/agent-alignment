  "env": {
    "XDG_CACHE_HOME": "~/.cache-agent",
    "PIP_CACHE_DIR": "~/.cache-agent/pip",
    "npm_config_cache": "~/.cache-agent/npm",
    "npm_config_ignore_scripts": "true",
    "UV_CACHE_DIR": "~/.cache-agent/uv",
    "PRE_COMMIT_HOME": "~/.cache-agent/pre-commit",
    "PLAYWRIGHT_BROWSERS_PATH": "~/.cache-agent/ms-playwright",
    "ANSIBLE_HOME": "~/.cache-agent/ansible",
    "ANSIBLE_LOCAL_TEMP": "~/.cache-agent/ansible/tmp",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "PIP_CERT": "/etc/ssl/certs/ca-certificates.crt"
  },
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    {"serverUrl": "https://api.githubcopilot.com/mcp/readonly"}
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /etc/claude-code/hooks/guard_outward.py",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking outward-action guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /etc/claude-code/hooks/tells_check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh /etc/claude-code/hooks/after_summary.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Pushing to any git remote, or any command or script that sends commits, branches or tags off this machine.",
      "Creating, merging, approving, reviewing, commenting on, editing, closing or reopening GitHub pull requests, issues, releases or repositories, by gh, the GitHub API, curl or any script.",
      "Any change to a Kubernetes cluster, remote host or cloud account: kubectl or helm writes, Argo CD sync or settings, ansible, ssh, scp, Vault writes, DNS, or any cloud or storage provider.",
      "Sending messages or content to Slack, email, chat, shared documents or any third-party service.",
      "Starting cloud or remote agents, sessions, triggers or routines.",
      "Reading or printing secret values: Vault, Kubernetes secrets, tfvars, age files, kubeconfigs, KeePass databases, password managers, .env files.",
      "Changing Claude Code or Codex settings, hooks, agent definitions or rules, or disabling hooks or the sandbox."
    ],
    "soft_deny": [
      "$defaults",
      "Launching more than three subagents at once, or a subagent that reviews another agent's review, when the user did not ask for it.",
      "Creating report, audit, status, evidence, review-request or plan files the user did not ask for by name."
    ],
    "environment": [
      "$defaults",
      "This is a personal workstation. Repositories under ~/projects may belong to other teams or clients. Agents may research public sources and read approved services. Never disclose secrets or send private project data to unrelated destinations. The user pushes, posts and changes live systems in their own terminal."
    ]
  },
  "isolatePeerMachines": true,
  "disableClaudeAiConnectors": true
}
